# CLI section

import argparse
import os
import shutil
import sys
import tomllib
from datetime import date
from pathlib import Path


IMAGE_EXTENSIONS = frozenset(
    {
        ".jpg",
        ".jpeg",
        ".png",
        ".heic",
        ".heif",
        ".tif",
        ".tiff",
        ".cr2",
        ".cr3",
        ".nef",
        ".arw",
        ".orf",
        ".rw2",
        ".raf",
        ".dng",
    }
)

VIDEO_EXTENSIONS = frozenset(
    {
        ".mp4",
        ".mov",
        ".m4v",
        ".avi",
        ".mkv",
        ".webm",
        ".3gp",
        ".mts",
    }
)

MEDIA_EXTENSIONS = IMAGE_EXTENSIONS | VIDEO_EXTENSIONS

DEFAULT_PICTURES_DIR = Path.home() / "Pictures" / "Import"
DEFAULT_VIDEOS_DIR = Path.home() / "Videos" / "Import"

CONFIG_KEYS = ("source_dir", "pictures_dir", "videos_dir")


def config_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "picimport" / "config.toml"


def load_config(path: Path | None = None) -> dict[str, Path]:
    """Read optional defaults; unknown keys and malformed values are ignored."""
    path = path or config_path()
    settings: dict[str, Path] = {}
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return settings
    except (OSError, tomllib.TOMLDecodeError) as exc:
        print(f"warning: ignoring unreadable config {path}: {exc}", file=sys.stderr)
        return settings
    for key in CONFIG_KEYS:
        value = data.get(key)
        if isinstance(value, str) and value.strip():
            settings[key] = Path(value).expanduser()
    return settings


def media_kind(path: Path) -> str:
    return "video" if path.suffix.lower() in VIDEO_EXTENSIONS else "image"


def capture_date(path: Path) -> date:
    dt = read_capture_datetime(path)
    if dt is not None:
        return dt.date()
    return date.fromtimestamp(path.stat().st_mtime)


def iter_media(source: Path):
    for path in sorted(source.rglob("*")):
        if path.is_file() and path.suffix.lower() in MEDIA_EXTENSIONS:
            yield path


def resolve_target(dest_dir: Path, src: Path) -> Path | None:
    """None means skip (same name+size exists); otherwise a safe target path."""
    candidate = dest_dir / src.name
    if not candidate.exists():
        return candidate
    try:
        if candidate.stat().st_size == src.stat().st_size:
            return None
    except OSError as exc:
        raise OSError(f"cannot inspect {candidate}: {exc}") from exc
    stem, dot, ext = src.name.partition(".")
    for i in range(1, 10_000):
        alt = dest_dir / f"{stem}_{i}.{ext}" if dot else dest_dir / f"{stem}_{i}"
        if not alt.exists():
            return alt
    raise OSError(f"no free name for {src} in {dest_dir}")


def import_photos(
    source: Path,
    pictures_dir: Path,
    videos_dir: Path,
    dry_run: bool = False,
    assume_yes: bool = False,
) -> int:
    if not source.is_dir():
        print(f"error: source is not a directory: {source}", file=sys.stderr)
        return 2

    roots = {"image": pictures_dir, "video": videos_dir}
    copied: list[tuple[Path, Path]] = []
    counts = {"image": 0, "video": 0}
    skipped = 0
    failed = 0

    for src in iter_media(source):
        kind = media_kind(src)
        try:
            day = capture_date(src)
        except OSError as exc:
            print(f"error: {exc}", file=sys.stderr)
            failed += 1
            continue
        dest_dir = roots[kind] / day.isoformat()
        try:
            target = resolve_target(dest_dir, src)
        except OSError as exc:
            print(f"error: {exc}", file=sys.stderr)
            failed += 1
            continue
        if target is None:
            skipped += 1
            continue

        if dry_run:
            print(f"would copy {src} -> {target}")
            counts[kind] += 1
            continue

        print(f"copying {src} -> {target}")
        try:
            dest_dir.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src, target)
            if target.stat().st_size != src.stat().st_size:
                raise OSError(f"verification failed for {target}")
        except OSError as exc:
            print(f"error: {exc}", file=sys.stderr)
            failed += 1
            try:
                target.unlink()
            except OSError:
                pass
            continue
        copied.append((src, target))
        counts[kind] += 1

    if dry_run:
        print(
            f"dry run complete: "
            f"{counts['image']} image(s), {counts['video']} video(s) would be copied; "
            f"{skipped} would be skipped"
        )
        return 0

    deleted = 0
    # Every entry in `copied` passed the post-copy byte-length verification;
    # failed files were never appended, so only safe candidates are listed.
    if copied:
        prompt = f"Delete {len(copied)} copied file(s) from {source}? [y/N] "
        if assume_yes:
            answer = "y"
        else:
            try:
                answer = input(prompt).strip().lower()
            except EOFError:
                answer = ""
        if answer in ("y", "yes"):
            for src, _ in copied:
                try:
                    src.unlink()
                    deleted += 1
                except OSError as exc:
                    print(f"error: could not delete {src}: {exc}", file=sys.stderr)

    print(
        f"Copied {counts['image']} image(s), {counts['video']} video(s), "
        f"Skipped {skipped}, Failed {failed}, Deleted {deleted}"
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="picimport",
        description=(
            "Copy photos into ~/Pictures/Import/<date>/ and videos into "
            "~/Videos/Import/<date>/ by EXIF capture date. Defaults may be set "
            "in ~/.config/picimport/config.toml; command-line flags win."
        ),
    )
    parser.add_argument("-i", "--input", type=Path,
                        help="source directory containing media (default: source_dir from config)")
    parser.add_argument("-p", "--pictures-dir", type=Path,
                        help=f"destination root for images (default: {DEFAULT_PICTURES_DIR})")
    parser.add_argument("-V", "--videos-dir", type=Path,
                        help=f"destination root for videos (default: {DEFAULT_VIDEOS_DIR})")
    parser.add_argument("--config", type=Path,
                        help="alternative config file path")
    parser.add_argument("-n", "--dry-run", action="store_true",
                        help="show what would be done without copying")
    parser.add_argument("-y", "--yes", action="store_true",
                        help="auto-confirm deleting copied files from source")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    cfg = load_config(args.config)

    source = (args.input or cfg.get("source_dir"))
    pictures_dir = args.pictures_dir or cfg.get("pictures_dir") or DEFAULT_PICTURES_DIR
    videos_dir = args.videos_dir or cfg.get("videos_dir") or DEFAULT_VIDEOS_DIR

    if source is None:
        print(
            "error: no source given; pass -i PATH or set source_dir in "
            f"{args.config or config_path()}",
            file=sys.stderr,
        )
        return 2

    return import_photos(
        source.resolve(),
        pictures_dir.expanduser(),
        videos_dir.expanduser(),
        args.dry_run,
        args.yes,
    )


if __name__ == "__main__":
    sys.exit(main())

