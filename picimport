#!/usr/bin/env python3
"""picimport — copy photos and videos into date-organized folders.

Single-file CLI, Python 3.13 standard library only. Copy it anywhere on PATH
(e.g. ~/.local/bin) and it just works. Reads each media file's EXIF capture
time (built-in minimal parser, no dependencies) and files it under
~/Pictures/Import/<YYYY-MM-DD>/ for images and ~/Videos/Import/<YYYY-MM-DD>/
for videos. Copy-only by default; verified delete from source only after
explicit confirmation.

Usage:
  picimport -i <path> [-n] [-y] [-p DIR] [-V DIR] [--config FILE]

This file is part of picimport. Licensed under GPLv3; see LICENSE
or <https://www.gnu.org/licenses/gpl-3.0.txt>.
"""

from __future__ import annotations

import argparse
import os
import shutil
import struct
import sys
import tomllib
from datetime import date, datetime
from pathlib import Path

VERSION = "1.1.0"

from datetime import datetime
from pathlib import Path

# Preference order: best first.
_DATE_TAGS = (0x9003, 0x9004, 0x0132)  # DateTimeOriginal, Digitized, DateTime
_EXIF_IFD_TAG = 0x8769

_TYPE_SIZES = {1: 1, 2: 1, 3: 2, 4: 4, 5: 8, 6: 1, 7: 1, 8: 2, 9: 4, 10: 8, 11: 4, 12: 8}

_DATE_FORMATS = ("%Y:%m:%d %H:%M:%S", "%Y-%m-%d %H:%M:%S")


def _parse_date(value: str) -> datetime | None:
    value = value.strip().strip("\x00")
    for fmt in _DATE_FORMATS:
        try:
            return datetime.strptime(value[:19], fmt)
        except ValueError:
            continue
    return None


def _read_ascii(data: bytes, offset: int, count: int) -> str:
    return data[offset : offset + count].decode("ascii", errors="replace")


def _tiff_dates(data: bytes) -> dict[int, str]:
    """Extract date-tag strings from a TIFF structure."""
    if len(data) < 8:
        raise ValueError("short TIFF")
    order = data[:2]
    if order == b"II":
        endian = "<"
    elif order == b"MM":
        endian = ">"
    else:
        raise ValueError("bad byte order")
    if struct.unpack(endian + "H", data[2:4])[0] != 42:
        raise ValueError("bad magic")
    ifd_offset = struct.unpack(endian + "I", data[4:8])[0]
    dates: dict[int, str] = {}
    seen_ifds = set()
    while 0 < ifd_offset < len(data) and ifd_offset not in seen_ifds:
        seen_ifds.add(ifd_offset)
        entry_count = struct.unpack(endian + "H", data[ifd_offset : ifd_offset + 2])[0]
        next_offset = struct.unpack(
            endian + "I", data[ifd_offset + 2 : ifd_offset + 6]
        )[0]
        for i in range(entry_count):
            base = ifd_offset + 2 + i * 12
            tag, ftype, count = struct.unpack(
                endian + "HHI", data[base : base + 8]
            )
            size = _TYPE_SIZES.get(ftype)
            if size is None or count == 0 or count > 4096:
                continue
            total = size * count
            if total <= 4:
                value_offset = base + 8
            else:
                value_offset = struct.unpack(endian + "I", data[base + 8 : base + 12])[0]
            if value_offset + min(total, 64) > len(data):
                continue
            if ftype == 2 and tag in _DATE_TAGS:
                dates[tag] = _read_ascii(data, value_offset, count)
            elif tag == _EXIF_IFD_TAG and ftype == 4:
                next_offset = struct.unpack(
                    endian + "I", data[value_offset : value_offset + 4]
                )[0]
        ifd_offset = next_offset
    return dates


def _jpeg_exif_tiff(path: Path) -> bytes | None:
    """Return the raw TIFF block from a JPEG Exif APP1 segment, if any."""
    with open(path, "rb") as fh:
        if fh.read(2) != b"\xff\xd8":
            return None
        while True:
            marker = fh.read(2)
            if len(marker) < 2 or marker[0] != 0xFF or marker[1] in (0xD8, 0x01):
                return None
            while marker[1] == 0xFF:  # fill bytes
                marker = marker[:1] + fh.read(1)
            if marker[1] == 0xD9 or marker[1] == 0xDA:  # EOI / start of scan
                return None
            length_bytes = fh.read(2)
            if len(length_bytes) < 2:
                return None
            length = int.from_bytes(length_bytes, "big") - 2
            payload = fh.read(length)
            if marker[1] == 0xE1 and payload.startswith(b"Exif\x00\x00"):
                return payload[6:]
            if length <= 0:
                return None


# TIFF-based RAW files (CR2/NEF/ARW/DNG/…) keep IFD0 and its date tags in
# the first kilobytes; the rest is sensor data. Dating must read only this
# head chunk — whole-file reads made dry runs minutes-slow on slow cards.
_TIFF_HEAD_BYTES = 256 * 1024


def read_capture_datetime(path: Path) -> datetime | None:
    """Best-effort EXIF capture datetime; None if unavailable."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(4)
        if head.startswith(b"\xff\xd8"):
            tiff = _jpeg_exif_tiff(path)
        elif head in (b"II*\x00", b"MM\x00*"):
            with open(path, "rb") as fh:
                tiff = fh.read(_TIFF_HEAD_BYTES)
        else:
            tiff = None
        if not tiff:
            return None
        dates = _tiff_dates(tiff)
        if (
            not dates
            and len(tiff) == _TIFF_HEAD_BYTES
            and path.getsize() > _TIFF_HEAD_BYTES
        ):
            # Rare: date tags pointed beyond the head chunk — reread whole.
            dates = _tiff_dates(path.read_bytes())
        for tag in _DATE_TAGS:
            dt = _parse_date(dates[tag]) if tag in dates else None
            if dt is not None:
                return dt
        return None
    except (OSError, ValueError, KeyError, struct.error):
        return None


